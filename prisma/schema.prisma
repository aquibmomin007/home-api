// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroceryCategory {
  veggies
  meat
  fish
  sauce
  cooked_food
}

model Task {
  id        String     @id @default(cuid())
  title     String
  completed Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("tasks")
}

model Device {
  id        String     @id @default(cuid())
  name      String
  token     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("devices")
}

model Grocery {
  id         String          @id @default(cuid())
  name       String
  category   GroceryCategory
  dateAdded  DateTime
  openedDate DateTime?
  finished   Boolean         @default(false)
  finishedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("groceries")
}

model FlightDealState {
  id              String   @id @default(cuid())
  itineraryKey    String   @unique
  routeType       String
  origin          String
  destination     String
  windowLabel     String
  outboundDate    DateTime
  returnDate      DateTime
  lastSeenPrice   Int
  currency        String   @default("SGD")
  cabin           String
  stops           Int
  airline         String
  baggageIncluded Boolean
  lastSeenAt      DateTime @default(now())
  lastAlertPrice  Int?
  lastAlertAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([destination, routeType])
  @@index([lastSeenAt])
  @@map("flight_deal_states")
}
